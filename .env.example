# Used by `cargo run -- serve` in dev. In production these are set by the k8s
# Deployment / Secret. SILENT_ACCOUNTS_JSON overrides any [[accounts]] in config.toml.
SILENT_BALANCE_CONFIG=./config.toml
RUST_LOG=info,silent_balance_tracker=debug

# Optional override (k8s style):
# SILENT_ACCOUNTS_JSON=[{"name":"primary","url":"https://silent.link/order/AAA"}]
